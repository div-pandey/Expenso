# ==============================================================================
# EXPENSO ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local for local development. Never commit real keys!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER-SIDE ENVIRONMENT VARIABLES (Vercel Serverless Functions / Cloud)
# Read exclusively in /api/verify-upi.ts via process.env. Never prefix with VITE_!
# ------------------------------------------------------------------------------
# Google Gemini API Key (Free tier from Google AI Studio: https://aistudio.google.com/app/apikey)
# Used securely by the serverless proxy to verify payment proof screenshots & UTRs
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 2. CLIENT-SIDE ENVIRONMENT VARIABLES (Vite Frontend Bundle)
# Prefixed with VITE_ to allow compilation into the client app bundle
# ------------------------------------------------------------------------------
# Supabase Configuration (Optional for cloud sync; local sandbox works offline)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
